# Next.js app (.env.local, git-ignored)

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side Convex variables are NOT read from this file. Set them on the
# Convex deployment instead (see README → Environment variables):
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set N8N_WEBHOOK_URL         http://localhost:5678/webhook/lendloop-loan-events  (local)
#                                              https://<tunnel>/webhook/lendloop-loan-events       (cloud)
#   npx convex env set N8N_WEBHOOK_SECRET      <same value as n8n/.env>
#   npx convex env set CONVEX_HTTP_SECRET      <same value as n8n/.env>
# Clerk → Integrations → Convex must be activated, or Convex never sees you as signed in.
