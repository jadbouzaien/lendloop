        440,
        300
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "lendloopDiscord1",
          "name": "LendLoop Discord webhook"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
