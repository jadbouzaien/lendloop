        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "ec8ff0fc-b01b-5e1e-826b-40c2e0dafe36",
      "name": "Convex: claim notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f17a831d-6439-5ca9-820e-7a221a525efd",
              "leftValue": "={{ $json.result }}",
              "rightValue": "duplicate",
