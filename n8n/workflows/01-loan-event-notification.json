    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.headers['x-lendloop-timestamp'] }}.{{ JSON.stringify($json.body) }}",
        "dataPropertyName": "expectedSignature",
        "encoding": "hex"
      },
      "id": "09403326-706e-5e4a-8117-ca8b5d3ce5f3",
      "name": "Expected signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "credentials": {
        "crypto": {
          "id": "lendloopHmacIn01",
          "name": "LendLoop HMAC – Convex → n8n"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convex signs `${timestamp}.${rawBody}` with HMAC-SHA256 (see convex/lib/signature.ts).\n// The body is canonical JSON.stringify output, so re-serialising the parsed body is byte-identical.\nconst item = $input.first().json;\nconst timestamp = String(item.headers['x-lendloop-timestamp'] ?? '');\nconst given = String(item.headers['x-lendloop-signature'] ?? '');\nconst expected = `sha256=${item.expectedSignature}`;\n\n// Constant-time comparison.\nlet diff = given.length ^ expected.length;\nfor (let i = 0; i < Math.min(given.length, expected.length); i++) {\n  diff |= given.charCodeAt(i) ^ expected.charCodeAt(i);\n}\nconst fresh = /^\\d{1,12}$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) <= 300;\nconst ev = item.body ?? {};\nconst wellFormed = typeof ev.eventId === 'string' && typeof ev.type === 'string' && Boolean(ev.loan?.id && ev.recipient?.displayName);\nconst valid = diff === 0 && fresh && wellFormed;\n\n// Only the verified event continues; headers are dropped here.\nreturn [{ json: { valid, reason: valid ? null : (diff !== 0 ? 'bad signature' : !fresh ? 'stale timestamp' : 'malformed event'), event: valid ? ev : null } }];"
      },
      "id": "7f9633a5-2077-56d6-8e86-4add8d45ce87",
      "name": "Verify signature & timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "38c5116b-f4c6-52a0-9692-8b5f192c33f9",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f0e76270-b948-5cb8-bfe6-967dc67dda86",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, eventId: $json.event.eventId } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "2b4e067b-a0e1-5b61-ae45-26b298bd9597",
      "name": "Respond 202 Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'invalid signature' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "cb12feda-4382-59a1-9509-b20c54a71e26",
      "name": "Respond 401 Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const ts = () => String(Math.floor(Date.now() / 1000));\n\n// Claim the idempotency key before sending, so a retried webhook never notifies twice.\nconst ev = $('Verify signature & timestamp').first().json.event;\nconst body = { idempotencyKey: `notification:${ev.eventId}`, loanId: ev.loan.id, kind: 'notification', status: 'claimed', detail: `${ev.type} → ${ev.recipient.role}` };\nreturn [{ json: { timestamp: ts(), rawBody: JSON.stringify(body) } }];"
      },
      "id": "a583e28c-e728-5488-95a6-6a54365ec777",
      "name": "Build claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.timestamp }}.{{ $json.rawBody }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "id": "be2fe71c-9ce2-57f2-bff7-15c663cdc4ef",
      "name": "Sign claim",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "credentials": {
        "crypto": {
          "id": "lendloopHmacOut1",
          "name": "LendLoop HMAC – n8n → Convex"
        }
      }
    },
    {
      "parameters": {
