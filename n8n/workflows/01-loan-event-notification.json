        "options": {}
      },
      "id": "ebf0e335-b09f-57aa-af26-7a2a7e7ea77a",
      "name": "First delivery?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1760,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Neutralise Discord mentions/markdown in user-supplied names.\nconst clean = (s) => String(s ?? '').replace(/[\\\\*_~`|>#\\[\\]()]/g, '\\\\$&').replace(/@/g, '@\\u200b').slice(0, 80);\n\nconst ev = $('Verify signature & timestamp').first().json.event;\nconst to = clean(ev.recipient.displayName);\nconst other = clean(ev.counterparty.displayName);\nconst tool = clean(ev.tool.name);\nconst dates = ev.loan.startDate === ev.loan.endDate ? ev.loan.startDate : `${ev.loan.startDate} → ${ev.loan.endDate}`;\n\nconst messages = {\n  'loan.requested': `📬 **${to}**, ${other} would like to borrow your **${tool}** (${dates}). Open LendLoop → Incoming requests to answer.`,\n  'loan.approved': `✅ **${to}**, ${other} approved your request for **${tool}** (${dates}).`,\n  'loan.declined': `🙅 **${to}**, your request for **${tool}** (${dates}) was declined.`,\n  'loan.cancelled': ev.recipient.role === 'lender'\n    ? `↩️ **${to}**, ${other} withdrew their request for **${tool}**.`\n    : `↩️ **${to}**, your request for **${tool}** was cancelled because the listing was removed.`,\n  'loan.returned': `📦 **${to}**, ${other} marked **${tool}** as returned. Thanks for borrowing!`,\n};\nconst content = messages[ev.type];\nif (!content) throw new Error(`Unknown event type: ${ev.type}`);\nreturn [{ json: { content } }];"
      },
      "id": "d4852059-fe29-590d-9fbd-17aa0329803f",
      "name": "Compose message",
