    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/automation-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "47a00ebb-d0cd-5a58-ad16-9312d627630a",
      "name": "Convex: record result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Status is already stored in Convex; failing the run triggers the error workflow alert.\nif ($('Build write-back').first().json.status === 'failed') {\n  throw new Error('Discord notification failed after retries (recorded in Convex)');\n}\nreturn $input.all();"
      },
      "id": "b6ca2dfe-ada1-5aed-8d5c-46bbc39132d6",
      "name": "Fail execution if not sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
