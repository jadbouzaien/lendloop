      "id": "7c44dac6-02d4-59ce-bb62-bfb8174c2d75",
      "name": "Discord: notify recipient",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        2200,
        100
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "lendloopDiscord1",
          "name": "LendLoop Discord webhook"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const ts = () => String(Math.floor(Date.now() / 1000));\n\n// The Discord node reports failures (after its own retries) as an item with `error`.\nconst ev = $('Verify signature & timestamp').first().json.event;\nconst error = $input.first().json.error;\nconst status = error ? 'failed' : 'sent';\nconst detail = error ? `${ev.type}: ${String(error.message ?? error).slice(0, 120)}` : `${ev.type} → ${ev.recipient.role}`;\nconst body = { idempotencyKey: `notification:${ev.eventId}`, loanId: ev.loan.id, kind: 'notification', status, detail };\nreturn [{ json: { status, timestamp: ts(), rawBody: JSON.stringify(body) } }];"
      },
