# Copy to n8n/.env (git-ignored) and fill in (README → Local setup → 4).
# N8N_ENCRYPTION_KEY, N8N_WEBHOOK_SECRET and CONVEX_HTTP_SECRET each need
# their OWN random value (min. 32 chars):  openssl rand -hex 32

# Encrypts credentials stored in n8n's database. Keep it stable once set.
# Passed to the container as a Docker secret file, not as an env var.
N8N_ENCRYPTION_KEY=

# The three values below are only read by setup.sh, which stores them as
# encrypted n8n credentials. They are NOT passed to the n8n container env.

# Convex -> n8n: Convex signs webhooks with this; n8n verifies.
# Must equal N8N_WEBHOOK_SECRET in the Convex deployment env.
N8N_WEBHOOK_SECRET=

# n8n -> Convex: n8n signs HTTP calls with this; Convex verifies.
# Must equal CONVEX_HTTP_SECRET in the Convex deployment env.
CONVEX_HTTP_SECRET=

# Discord channel webhook (Channel settings → Integrations → Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Convex HTTP actions URL, as seen from the n8n container. Not a secret.
#   Local Convex (default): http://host.docker.internal:3211
#   Cloud Convex:           https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211

# Optional
GENERIC_TIMEZONE=Europe/Paris
# N8N_VERSION=2.x.y   # pin the image version in production
